APP_NAME=Bayiinet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.bayiinet.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bayiinet
DB_USERNAME=bayiinet
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="destek@bayiinet.com"
MAIL_FROM_NAME="${APP_NAME}"

# İlk yönetici hesabı (sadece ilk kurulumda kullanılır)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Trendyol'dan ürün gönderirken kullanılan varsayılanlar
TRENDYOL_BATCH_SIZE=40
TRENDYOL_FALLBACK_BRAND_ID=2613880
TRENDYOL_BATCH_WAIT=9
TRENDYOL_MAX_PAGES=100
TRENDYOL_RETRY_TIMES=3
TRENDYOL_RETRY_SLEEP=1500
# Bayi satış fiyatı hesabında kullanılan pazaryeri komisyonu (%)
TRENDYOL_COMMISSION_RATE=15
# API çağrıları arasında beklenecek süre (ms) — hız sınırına takılmamak için
TRENDYOL_THROTTLE_MS=250

# Saatlik otomasyon (false yaparak kapatılabilir)
AUTO_XML_SYNC=true
AUTO_TRENDYOL_SYNC=true
AUTOMATION_HEARTBEAT_DELAY=75
# Görevler "son çalışmadan bu kadar dakika geçtiyse" çalışır (uykuda kalan
# sunucularda saat başının kaçırılmasını engeller)
AUTOMATION_XML_INTERVAL=55
AUTOMATION_TRENDYOL_INTERVAL=55
AUTOMATION_RECHECK_INTERVAL=14
# Trendyol gönderiminden kaç dakika sonra fiyat/stok eşitlensin
AUTOMATION_INVENTORY_DELAY=15

# Harici cron uçları (/cron/keepalive, /cron/hourly …) için gizli anahtar.
# Boş bırakılırsa bu uçlar kapalıdır. Örn: openssl rand -hex 24
CRON_TOKEN=
CRON_DRAIN_SECONDS=90

# Büyük XML feed'leri (akış okuması için eşik, byte)
XML_STREAM_THRESHOLD=8388608
XML_MAX_BYTES=209715200
XML_DOWNLOAD_TIMEOUT=600

# Web konteynerinde kuyruk işçisi / zamanlayıcı çalışsın mı?
# Ayrı Background Worker + Cron Job kullanıyorsanız false yapın.
RUN_QUEUE_WORKERS=true
RUN_SCHEDULER=true
RUN_MIGRATIONS=true
PHP_CLI_SERVER_WORKERS=3
